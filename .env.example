# Cloaker Configuration
NEXT_PUBLIC_CLOAKER_TRACKING_ENABLED=true
NEXT_PUBLIC_CLOAKER_TRACKING_ID=969-8f076e082dbcb1d080037ec2c216d589-15523

# Google Ads
NEXT_PUBLIC_GOOGLE_ADS_ENABLED=true
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_GTAG_CONVERSION_COMPRA=xxxxxxxxxxxxx

# UTMify
UTMIFY_API_TOKEN=your_utmify_token_here

# Allowed Domains (comma separated)
NEXT_PUBLIC_ALLOWED_DOMAINS=recarga-jogoff.shop,www.recarga-jogoff.shop

# Mercado Pago
NEXT_PUBLIC_MP_PUBLIC_KEY=your_mp_public_key
MP_ACCESS_TOKEN=your_mp_access_token

# Database
DATABASE_URL=your_database_url

# API Keys
NEXT_PUBLIC_API_URL=https://your-api-url.com

# Payment Gateway
# Para randomizar entre múltiplos gateways, separe por vírgula
# Exemplo: PAYMENT_GATEWAY=ghostpay,ezzpag,umbrela
PAYMENT_GATEWAY=ezzpag

# GhostPay
GHOSTPAY_API_KEY=your_secret_key_here
GHOSTPAY_COMPANY_ID=your_company_id_here

# Ezzpag
EZZPAG_API_AUTH=your_ezzpag_auth_here

# Umbrela
UMBRELA_API_KEY=your_umbrela_key_here
