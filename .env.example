# ===== VARIÁVEIS ESSENCIAIS PARA DEPLOY NO SERVIDOR =====
# Copie este arquivo para .env.local e preencha com seus dados reais

# 🔒 Verificação de Usuário (Pre-Land)
NEXT_PUBLIC_ENABLE_USER_VERIFICATION=true

# 🎯 OBRIGATÓRIO - Google Ads Tracking
NEXT_PUBLIC_GOOGLE_ADS_ENABLED=true
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GTAG_CONVERSION_COMPRA=XXXXXXXXXX

# 🧪 Teste de Conversão Google Ads (use /?fireboost=activar)
NEXT_PUBLIC_GOOGLE_AW_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL=XXXXXXXXXX

# 🌐 OBRIGATÓRIO - URL Base do Site
NEXT_PUBLIC_BASE_URL=https://seudominio.com

# 🛡️ OBRIGATÓRIO - Domínios Permitidos (separados por vírgula)
NEXT_PUBLIC_ALLOWED_DOMAINS=seudominio.com,www.seudominio.com

# 🚨 Gateway de Pagamento - Escolha: 'blackcat', 'ghostpay', 'nitro' ou 'ezzpag'
PAYMENT_GATEWAY=nitro

# BlackCat (API de pagamento PIX)
BLACKCAT_API_AUTH=Basic YOUR_BLACKCAT_API_AUTH_HERE

# GhostPay (API alternativa de pagamento PIX)
GHOSTPAY_API_KEY=sk_live_YOUR_GHOSTPAY_KEY_HERE

# Nitro Pagamentos (API de pagamento PIX)
NITRO_API_KEY=YOUR_NITRO_API_KEY_HERE

# EzzPag (API de pagamento PIX)
EZZPAG_API_AUTH=YOUR_EZZPAG_API_AUTH_HERE

# 🎯 OPCIONAL - UTMify (tracking de conversões)
UTMIFY_API_TOKEN=YOUR_UTMIFY_API_TOKEN_HERE
UTMIFY_ENABLED=false
UTMIFY_TEST_MODE=false
UTMIFY_WHITEPAGE_URL=https://recarga-digitalgames.it.com
NEXT_PUBLIC_UTMIFY_WHITEPAGE_URL=https://recarga-digitalgames.it.com

# 🎯 OPCIONAL - Cloaker Tracking
NEXT_PUBLIC_CLOAKER_TRACKING_ENABLED=false

# ===== OBSERVAÇÕES =====
# ✅ IMPORTANTE: Após criar .env.local, execute:
#    npm run build
#    pm2 restart seu-projeto
# ✅ URLs são detectadas dinamicamente do host atual
# ✅ Webhooks funcionam automaticamente em qualquer domínio
